<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pagina Principal</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.0.3/css/font-awesome.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="css/sidebars.css">
    <style>
        body {
            background-color: #BBDEFB
        }

        .bg-black {
            background-color: #000
        }

        .navbar-brand {
            padding: 11px 20px
        }

        .active {
            background-color: blue
        }

        .navbar-nav {
            width: 100%
        }

        .nav-link {
            color: #fff !important
        }

        .nav-item {
            padding: 6px 12px;
            text-align: center
        }

        .nav-item:hover {
            background-color: blue
        }

        .right {
            margin-left: auto
        }

        .navbar-collapse.collapse.in {
            display: block !important
        }

        @media (max-width: 992px) {
            .right {
                margin-left: 0
            }

            .nav-item {
                width: 100%;
                text-align: left
            }
        }
    </style>
</head>

<body>
    <div class="container-fluid px-0">
        <nav class="navbar navbar-expand-lg navbar-dark bg-black py-0 px-0"> <a class="navbar-brand"
                href="#"><strong><i>Gas-App</i></strong></a> <button class="navbar-toggler mr-3" type="button"
                data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false"
                aria-label="Toggle navigation"> <span class="navbar-toggler-icon"></span> </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item"> <a class="nav-link" href="/">Casa</a> </li>
                    <li class="nav-item"> <a class="nav-link" href="/paginas/precios">Productos</a> </li>
                    <li class="nav-item right"></li>
                    {{#if user2}}
                    <li class="nav-item"> <a class="nav-link" href="/notes">Inicio Trabajador</a> </li>
                    <li class="nav-item"> <a class="nav-link" href="/paginas/perfil">Perfil</a> </li>
                    <li class="nav-item"> <a class="nav-link" href="/paginas/sales">Ventas</a> </li>
                    <li class="nav-item right"> <a class="nav-link" href="/users/logout2">Logout</a>
                    </li>
                    {{else }}

                    <div class="btn-group">
                        <button type="button" class="btn btn-success dropdown-toggle dropdown-toggle-split"
                            data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">Registrarse</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/users/signup">Cliente</a></li>
                            <li><a class="dropdown-item" href="/users/signup3">Trabajador
                                </a></li>
                        </ul>
                    </div>
                    <div class="btn-group">
                        <button type="button" class="btn btn-success dropdown-toggle dropdown-toggle-split"
                            data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">Ingresar</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/users/signin">Cliente</a></li>
                            <li><a class="dropdown-item" href="/users/signin3">Trabajador
                                </a></li>
                        </ul>
                    </div>
                </ul>

            </div> {{/if}}

        </nav>
    </div>
</body>

</html>