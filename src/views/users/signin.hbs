<div class="row">
    <div class="col-md-4 mx-auto">
        <div class="card">
            <div class="card-header">
                Account lognin
            </div>
            <img src="/img/logo.jpg" class="rounded-circle mx-auto d-block m-4 logo" alt="">
            <div class="card-body">
                <form action="/users/signin" method="POST">

                    <div>Eliga 1 para el perfil de cliente.</div>
                    <div>Eliga 2 para perfil de trabajador.</div><br>
                    <div class="form-group">
                        <input type="text" class="form-group" name="perfil1" placeholder="Ingrese perfil">
                    </div>
                    <div class="form-group">
                        <input type="email" class="form-group" name="email1" placeholder="Ingrese Gmail">
                    </div>
                    <div class="form-group">
                        <input type="password" class="form-group" name="password1" placeholder="Ingrese Password">
                    </div>
                    <button class="btn btn-primary btn-block">
                        Enviar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>