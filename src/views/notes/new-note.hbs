<div class="col-md-4 mx-auto">
    <div class="card text-center">
        <div class="card-header">
            <h3>New Note</h3>
        </div>
        <form action="/notes/new-note" method="POST">
            <div class="form-group">
                <input type="text" name="nombre" class="form-control" placeholder="Nombre" required autofocus>
            </div>
            <div class="form-group">
            <input type="text" name="producto" class="form-control" placeholder="Producto" required autofocus>
            </div>
            <div class="form-group">
                <input type="text" name="cantidad" class="form-control"  required placeholder="Cantidad" autofocus>
            </div>
            <div class="form-group">
                <input type="text" name="precio" class="form-control" placeholder="Precio" required autofocus>
            </div>
            <div class="form-group">
                <input type="text" name="pago" class="form-control" placeholder="Pago" required autofocus>
            </div>
            <div class="form-group">
                <textarea name="direccion" placeholder="direccion" class="form-control" required></textarea>
            </div>
            <div class="form-group">
                <button class="btn btn-primary btn-block">
                   Save 
                </button>
            </div>
        </form>
    </div>
</div>